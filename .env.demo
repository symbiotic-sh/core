# Symbiotic demo environment — source this before running `symbiotic <cmd>`.
#   $ cd submodules/runtime && source .env.demo
# Picks a local Ollama provider so the demo runs fully offline.

export SYMBIOTIC_DEFAULT_PROVIDER=ollama
export SYMBIOTIC_OLLAMA_URL=http://localhost:11434
export SYMBIOTIC_OLLAMA_CHAT_MODEL=gemma4:e4b
export SYMBIOTIC_AGENT_BACKEND=react

# Absolute path to disk role overrides (researcher.toml, etc.) so they load
# regardless of the caller's CWD.
here_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export SYMBIOTIC_AGENT_ROLES_DIR="$here_dir/config/agents"

# Ollama context window. Ollama's default is 2048 tokens, which silently
# truncates long orchestrator conversations. Gemma/Qwen natively support 128K.
# 64K gives the orchestrator room to recall multiple specialist reports AND
# compose a memo in one shot without the archive-handoff flow bumping the
# ceiling (specialist reports ~5K each × 4 + system + memo composition).
export SYMBIOTIC_OLLAMA_NUM_CTX=65536
# Output token cap. Ollama's default truncates long responses (default varies
# 128-512 tokens). Orchestrator's final tool-call JSON can be 2-4K tokens when
# it includes the full decision memo, so we bump this generously.
export SYMBIOTIC_OLLAMA_NUM_PREDICT=8192

# Demo-friendly log level: info from symbiotic crates so the audience can see
# Recall hits, tool dispatches, capability issuance. `warn` elsewhere to keep
# noisy third-party crates (hyper, tungstenite, reqwest) quiet.
export RUST_LOG="${RUST_LOG:-symbiotic=info,symbiotic_daemon=info,symbiotic_agents=info,symbiotic_intake=info}"
