# Runtime settings (non-secret)
SYMBIOTIC_DOMAIN=symbiotic.sh
SYMBIOTIC_MATRIX_ROOM_CONTROL=#control
SYMBIOTIC_MATRIX_ROOM_INTAKE=#intake
SYMBIOTIC_MATRIX_ROOM_ALERTS=#alerts
SYMBIOTIC_MATRIX_ROOM_STATUS=#status
SYMBIOTIC_MATRIX_ROOM_GOALS=#goals
# Comma-separated Matrix user IDs allowed to issue commands (set explicitly before production)
SYMBIOTIC_ALLOWED_SENDERS=@owner:symbiotic.sh
# Development-only override; keep false in VPS/production
SYMBIOTIC_ALLOW_OPEN_ACCESS=false
SYMBIOTIC_PUSH_GATEWAY_URL=
SYMBIOTIC_PUSH_APNS_GATEWAY_URL=
SYMBIOTIC_PUSH_FCM_GATEWAY_URL=
SYMBIOTIC_PUSH_TELEMETRY_FILE=data/push/delivery.log
SYMBIOTIC_SIGNAL_ENDPOINT=
SYMBIOTIC_WORKER_CONCURRENCY=2
