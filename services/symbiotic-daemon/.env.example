# Symbiotic MVP environment template
# Matrix bootstrap
SYMBIOTIC_MATRIX_HOMESERVER=
SYMBIOTIC_MATRIX_USER=
SYMBIOTIC_MATRIX_PASSWORD=
# Optional: set to skip matrix reachability probe in restricted environments
SYMBIOTIC_MATRIX_PROBE_MODE=
# Optional: set to skip curl availability probe (fallbacks to stub fetcher)
SYMBIOTIC_CURL_CHECK=

# Provider mode: BYOK (agent CLI + X API)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
SYMBIOTIC_X_CLIENT_ID=
SYMBIOTIC_X_CLIENT_SECRET=
SYMBIOTIC_X_REDIRECT_URI=https://symbiotic.sh/oauth/x/callback
SYMBIOTIC_X_TOKEN_ENDPOINT=https://api.twitter.com/2/oauth2/token

# Provider mode: managed passthrough
SYMBIOTIC_METERED_PLAN_ID=

# VPS provisioning (optional for mock flow)
SYMBIOTIC_VPS_PROVISION_ENDPOINT=
SYMBIOTIC_VPS_PROVISION_TOKEN=
SYMBIOTIC_HCLOUD_TOKEN=
SYMBIOTIC_VPS_REGION=us-east-1
SYMBIOTIC_VPS_SIZE=shared-cpu-2x
SYMBIOTIC_VPS_IMAGE=ubuntu-24-04

# Push gateway routing
SYMBIOTIC_PUSH_GATEWAY_URL=
SYMBIOTIC_PUSH_GATEWAY_API_KEY=
SYMBIOTIC_PUSH_APNS_GATEWAY_URL=
SYMBIOTIC_PUSH_APNS_GATEWAY_API_KEY=
SYMBIOTIC_PUSH_FCM_GATEWAY_URL=
SYMBIOTIC_PUSH_FCM_GATEWAY_API_KEY=

# Optional LLM router fallback
SYMBIOTIC_OPENROUTER_API_KEY=
