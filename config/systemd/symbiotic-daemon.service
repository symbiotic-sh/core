[Unit]
Description=Symbiotic Nucleus Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=symbiotic
Group=symbiotic
WorkingDirectory=/opt/symbiotic
EnvironmentFile=/opt/symbiotic/config/.env.runtime
EnvironmentFile=-/opt/symbiotic/config/.env.secrets
ExecStart=/usr/local/bin/symbiotic-daemon serve --queue-file /opt/symbiotic/data/queue/jobs.state
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
