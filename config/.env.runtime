# Symbiotic Daemon Runtime Configuration
# Non-secret settings - safe to commit as template
#
# IMPORTANT: Do NOT leave optional vars as empty (VAR=) — this overrides
# Rust defaults with blank strings. Comment them out instead.

# --- Matrix connection ---
# For daemon running inside Docker Compose network:
#   http://conduwuit:8008
# For host-side probes (installer verify / live-readiness without --skip-probes):
#   use a host-reachable URL (e.g. http://127.0.0.1:8008 or http://<tailscale-ip>:8008)
SYMBIOTIC_MATRIX_HOMESERVER=http://conduwuit:8008
SYMBIOTIC_MATRIX_USER=testuser
# Public app endpoint (required for --access-mode public or caddy).
# This is the domain used by mobile/simulator clients to reach the homeserver.
# For Caddy mode: Caddy auto-provisions TLS via Let's Encrypt for this domain.
# For public mode: domain is routed through Cloudflare Tunnel.
# Example: matrix.your-domain.com
# Production: SYMBIOTIC_MATRIX_PUBLIC_DOMAIN=matrix.symbiotic.sh
#SYMBIOTIC_MATRIX_PUBLIC_DOMAIN=
# Set to "true" to allow unencrypted Matrix transport (dev/testing only).
# VPS/production: MUST be false (E2EE enforced).
# Local dev: set to true in a local override file, not here.
#SYMBIOTIC_MATRIX_ALLOW_UNENCRYPTED=true

# --- Bootstrap ---
# When true, daemon will auto-register on Conduit if no password is provided.
# Only safe for local dev (Conduit must have allow_registration=true).
# Production: set to false and provide password via Docker secret.
#SYMBIOTIC_BOOTSTRAP_SELF_REGISTER=false

# --- Authorization / Sender Policy ---
# Comma-separated Matrix user IDs allowed to issue commands.
# This is the fail-closed sender allowlist. Commands from unlisted senders
# are rejected. Example:
#   @alice:symbiotic.local,@bob:symbiotic.local
SYMBIOTIC_ALLOWED_SENDERS=@testuser:symbiotic.local
# Development-only override. MUST be false on VPS/production.
# When true, any Matrix user can issue commands (no sender check).
SYMBIOTIC_ALLOW_OPEN_ACCESS=false

# --- Worker settings ---
SYMBIOTIC_LOG_LEVEL=info
SYMBIOTIC_FETCH_MODE=curl
SYMBIOTIC_WORKER_ID=vps-daemon-01
SYMBIOTIC_LEASE_SECONDS=300

# --- OAuth defaults (non-secret) ---
SYMBIOTIC_X_REDIRECT_URI=https://symbiotic.sh/oauth/x/callback

# --- VPS provisioning defaults ---
SYMBIOTIC_VPS_REGION=us-east-1
SYMBIOTIC_VPS_SIZE=shared-cpu-2x
SYMBIOTIC_VPS_IMAGE=ubuntu-24-04

# --- Repo workspace ---
# Path inside container where the writable repo worktree is mounted.
# The daemon passes this to agent providers as the working directory.
SYMBIOTIC_REPO_WORKSPACE=/app/repo

# --- AI / LLM providers ---
# Ollama (local LLM) for embeddings and agent completions.
# When running with Docker Compose, use the service name:
#SYMBIOTIC_OLLAMA_URL=http://ollama:11434
# Chat model for agent completions (default: qwen3.5).
#SYMBIOTIC_OLLAMA_CHAT_MODEL=qwen3.5

# Agent execution backend: "react" (internal ReAct loop, default) or "cli"
# (external Claude Code / Codex CLI via env vars).
SYMBIOTIC_AGENT_BACKEND=react

# Cloud provider API keys (optional, override local Ollama for completions).
# These are secrets — consider placing in .env.secrets instead.
#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=
#GEMINI_API_KEY=
# Gemini model override (default: gemini-2.5-flash).
#SYMBIOTIC_GEMINI_MODEL=gemini-3.1-pro-preview
#OPENROUTER_API_KEY=

# --- Push notifications (optional) ---
# Leave unset to use defaults; empty values override defaults with blank.
#SYMBIOTIC_PUSH_GATEWAY_URL=
#SYMBIOTIC_PUSH_APNS_GATEWAY_URL=
#SYMBIOTIC_PUSH_FCM_GATEWAY_URL=
#SYMBIOTIC_PUSH_TELEMETRY_FILE=
